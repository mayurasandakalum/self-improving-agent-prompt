# OpenRouter Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The model to use. Recommended choices:
# - anthropic/claude-3.5-sonnet:beta (Fast, highly accurate, cost-effective)
# - anthropic/claude-3-opus (Original plan recommendation, deep reasoner)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet:beta

# OpenRouter tracking headers
OPENROUTER_HTTP_REFERER=https://yourcompany.example
OPENROUTER_X_TITLE=voice-prompt-improver

# Application Logs Config (trace, debug, info, warn, error)
LOG_LEVEL=info

# Default constraints
DEFAULT_MAX_RETRIES=1
DEFAULT_TIMEOUT_MS=60000
